---
import Base from "../../layouts/Base.astro";
import { getTags } from "../../lib/stream";
import { url } from "../../lib/format";

const tags = await getTags();
---

<Base title="Tags">
  <h1>Tags</h1>
  <ul class="tag-cloud">
    {tags.map(([tag, count]) => (
      <li><a href={url(`/tags/${tag}/`)}>#{tag}</a><span class="count">{count}</span></li>
    ))}
  </ul>
</Base>
